# Database PostgreSQL 17 (isolated DB for IT Tracker)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="it_tracker"
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/it_tracker"
DIRECT_URL="postgresql://postgres:CHANGE_ME@localhost:5432/it_tracker"

# Authentication & Cron Security (generate with: openssl rand -hex 32)
JWT_SECRET="CHANGE_ME_MIN_32_CHARS"
CRON_SECRET="CHANGE_ME_MIN_32_CHARS"

# Public HTTPS URL of this application (used in QR codes & Telegram links)
NEXT_PUBLIC_APP_URL="https://projectmng.royalmedicalink.id"

# Telegram Bot Notifications & Webhook Signature
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# Object Storage (MinIO S3 in docker-compose.gcp.yml; keep empty ONLY if running app without MinIO to use local /app/.uploads)
MINIO_ENDPOINT="http://ittracker-minio:9000"
MINIO_ACCESS_KEY="CHANGE_ME_MINIO_USER"
MINIO_SECRET_KEY="CHANGE_ME_MINIO_PASSWORD"
MINIO_BUCKET="ittracker-files"
MINIO_REGION="ap-southeast-2"
